  // --- Card ---
  backgroundColor?: string;
  borderColor?: string;
  borderWidth?: number;
  borderRadius?: string;
  shadow?: string;
  /** Inner padding of the card, e.g. "16px" or "12px 20px". Gives shadows room to breathe. */
  cardPadding?: string;
  animation?: HighlightAnimation;
  // --- Title atom ---
  titleFont?: string;
  titleColor?: string;
  titleSize?: number;
  titleWeight?: string;
  // --- Price atom ---
  priceFont?: string;
  priceColor?: string;
  priceSize?: number;
  priceWeight?: string;
  // --- Description atom ---
  descriptionFont?: string;
  descriptionColor?: string;
  descriptionSize?: number;
  // --- Badge (optional on any state) ---
  badge?: MenuItemBadge;
  // --- Icon (optional on any state) ---
