@import "tailwindcss";
@custom-variant dark (&:where(.dark, .dark *));

/* ─── @soustools/design-system — Neon-Glass Token Dictionary ───────────────── */

@theme {
  /* Primary — Dynamic based on theme */
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);

  /* Base theme mappings */
  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-border: var(--border);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-input: var(--input);
  --color-ring: #00ffff;

  /* ── Z-Index Scale ──────────────────────────────────────────────────────── */
  --z-overlay: 40;
  --z-bottom-nav: 40;
  --z-sidebar: 50;
  --z-appbar: 50;
  --z-omnibar: 60;
  --z-modal: 100;
  --z-toast: 150;

  /* ── Radii ──────────────────────────────────────────────────────────────── */
  --radius-lg: 0.8rem;
  --radius-md: calc(0.8rem - 2px);
  --radius-sm: calc(0.8rem - 4px);
}

@layer base {
  :root {
    --primary: #0891b2;
    --primary-foreground: #ffffff;
    --background: #f4f4f5; /* clean off-white */
    --foreground: #18181b; /* deep charcoal */
    --card: #ffffff; /* pure white for frosted glass */
    --card-foreground: #18181b;
    --popover: #ffffff;
    --popover-foreground: #18181b;
    --border: #e4e4e7; /* subtle light gray */
    --muted: #f4f4f5;
    --muted-foreground: #71717a;
    --accent: #e4e4e7;
    --accent-foreground: #18181b;
    --secondary: #e4e4e7;
    --secondary-foreground: #18181b;
    --destructive: #f43f5e;
    --destructive-foreground: #ffffff;
    --input: #e4e4e7;
  }

  .dark {
    --primary: #00ffff; /* True Neon Cyan */
    --primary-foreground: #000000;
    --background: #09090b; /* True Midnight Slate */
    --foreground: #ffffff;
    --card: #18181b; /* Elevated dark slate */
    --card-foreground: #ffffff;
    --popover: #18181b;
    --popover-foreground: #ffffff;
    --border: #27272a; /* subtle dark border */
    --muted: #121212;
    --muted-foreground: #a1a1aa;
    --accent: #27272a;
    --accent-foreground: #f8fafc;
    --secondary: #27272a;
    --secondary-foreground: #f8fafc;
    --destructive: #f43f5e;
    --destructive-foreground: #f8fafc;
    --input: #27272a;
  }

  *,
  *::before,
  *::after {
    border-color: var(--color-border);
    box-sizing: border-box;
  }

  body {
    background-color: var(--color-background);
    color: var(--color-foreground);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  /* Slim scrollbar — Neon-Glass surface optimised */
  ::-webkit-scrollbar {
    width: 4px;
    height: 4px;
  }
  ::-webkit-scrollbar-track {
    background: transparent;
  }
  ::-webkit-scrollbar-thumb {
    background-color: #27272a;
    border-radius: 9999px;
    transition: background-color 150ms ease;
  }
  ::-webkit-scrollbar-thumb:hover {
    background-color: #3f3f46;
  }
}

@layer utilities {
  .neon-glow {
    box-shadow:
      0 0 15px -3px rgb(0 255 255 / 0.7),
      0 0 6px -2px rgb(0 255 255 / 0.5);
  }
  .neon-glow-lg {
    box-shadow:
      0 0 35px -5px rgb(0 255 255 / 0.6),
      0 0 15px -3px rgb(0 255 255 / 0.4);
  }
  .neon-glow-pink {
    box-shadow:
      0 0 15px -3px rgb(247 37 133 / 0.7),
      0 0 6px -2px rgb(247 37 133 / 0.5);
  }
  .neon-border {
    border-color: rgb(0 255 255 / 0.6);
    box-shadow:
      inset 0 0 12px rgb(0 255 255 / 0.15),
      0 0 12px rgb(0 255 255 / 0.25);
  }

  .sidebar-collapsed a {
    justify-content: center !important;
    gap: 0 !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
  .sidebar-collapsed a span {
    display: none !important;
  }
}
</file>

