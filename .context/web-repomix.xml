<file path="turbo.json">
{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "INFISICAL_MOCK",
    "INFISICAL_CLIENT_ID",
    "INFISICAL_CLIENT_SECRET",
    "INFISICAL_PROJECT_ID",
    "INFISICAL_ENV"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "dependsOn": [
        "@soustools/config#build",
        "^build"
      ],
      "persistent": true
    },
    "lint": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    },
    "typecheck": {
      "cache": true,
      "dependsOn": [
        "^build"
      ]
    }
  }
}
</file>

