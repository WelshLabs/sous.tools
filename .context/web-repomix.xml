  iconPosition?: "before-title" | "after-title" | "top-right-corner";
  // --- Sold-out specific ---
  hidden?: boolean;
  strikethrough?: boolean;
  dimOpacity?: number;
  grayscale?: boolean;
}

/** Per-deck menu item styles covering all three display states. */
