          <button
            onClick={handleSave}
            disabled={isSubmitting}
            className="flex-1 py-3 bg-sky-500 hover:bg-sky-600 text-foreground rounded-xl font-bold transition-colors cursor-pointer disabled:opacity-50"
          >
            {isSubmitting ? "Saving..." : "Save Vendor"}
          </button>
        </div>

      </div>
    </div>
  );
}
