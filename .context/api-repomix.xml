    } catch (err) {
      return {
        success: false,
        error: err instanceof Error ? err.message : "Unknown error",
        timestamp: new Date().toISOString(),
      };
    }
  }

  @Post()
  @ApiBody({
    schema: {
      type: "object",
      properties: {
        recipe: {
          type: "object",
          properties: {
            title: { type: "string" },
            yieldCount: { type: "number" },
            yieldUnit: { type: "string" },
            instructions: { 
              type: "array",
              items: {
                type: "object",
                properties: {
                  text: { type: "string" },
                  stepNumber: { type: "number" },
                  timerDurationSeconds: { type: "number", nullable: true }
                }
              }
            },
            status: { type: "string" }
          }
