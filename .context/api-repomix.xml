    }
  })
  @NestjsApiResponse({ status: 201, description: "Success", schema: { type: "object", additionalProperties: true } })
  async create(
    @Body("recipe")
    recipe: Omit<
      Recipe,
      "id" | "organizationId" | "createdAt" | "recipeIngredients" | "vessel"
    >,
