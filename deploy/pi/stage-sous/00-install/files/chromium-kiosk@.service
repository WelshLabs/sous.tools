[Unit]
Description=Sous Chromium Kiosk Instance (%i)
After=sous-sway.service
Requires=sous-sway.service

[Service]
Type=simple
User=sous
Group=sous

Environment=WAYLAND_DISPLAY=wayland-1
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=DISPLAY=

# %i is the instance name: screen-1 or screen-2
ExecStart=/usr/bin/chromium-browser \
    --kiosk \
    --noerrdialogs \
    --disable-infobars \
    --no-first-run \
    --disable-features=Translate \
    --enable-features=UseOzonePlatform \
    --ozone-platform=wayland \
    --user-data-dir=/tmp/chromium-%i \
    --window-name="sous-%i" \
    http://localhost:3000/display/%i

# SIGUSR1 triggers a soft page reload (used by OTA without compositor restart)
KillSignal=SIGUSR1
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=sous-sway.service
