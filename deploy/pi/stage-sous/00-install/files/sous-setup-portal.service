[Unit]
Description=Sous Signage Setup Portal (Next.js standalone, port 3100)
Documentation=https://sous.tools
After=network.target sous-labwc.service
Wants=network.target

[Service]
Type=simple
User=sous
Group=sous
WorkingDirectory=/opt/sous.tools/apps/setup-portal

# PORT 3100: distinct from the main app (3000) so both can run simultaneously
# after the kiosk transitions. The setup portal remains available for re-pairing.
Environment=NODE_ENV=production
Environment=PORT=3100
Environment=HOSTNAME=0.0.0.0
Environment=SOUS_DEVICE_CONFIG=/etc/sous/device-config.json
Environment=SOUS_KIOSK_MODE_FILE=/etc/sous/kiosk-mode
Environment=SOUS_BOOTSTRAP_LOG=/var/log/sous-bootstrap.log

# Standalone Next.js output: server.js is generated by `next build` with output:'standalone'
ExecStart=/usr/bin/node .next/standalone/server.js

Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
