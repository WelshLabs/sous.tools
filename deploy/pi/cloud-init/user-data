#cloud-config
# Sous Tools Signage Node — Firstboot Configuration
#
# USAGE:
#   1. Download the custom generic signage .img.xz
#   2. Flash to SD card using Raspberry Pi Imager
#   3. Insert SD card → Pi boots → cloud-init runs automatically
#
# The Pi will self-configure by running the injected ansible playbook on first boot.
# No PATs or SSH keys required!

package_update: true
package_upgrade: true

packages:
  - ansible
  - git
  - curl
  - python3-pip

write_files:
  - path: /tmp/firstboot-bootstrap.sh
    permissions: "0700"
    content: |
      #!/bin/bash
      set -e

      echo "[Bootstrap] Running local ansible-playbook to configure device..."
      
      # The github action injects the 'ansible' directory into the boot partition
      # Copy it to /opt/ansible
      cp -r /boot/firmware/ansible /opt/ansible
      
      cd /opt/ansible
      
      # Run playbook locally
      ansible-playbook -c local -i "localhost," playbook.yml 2>&1 | tee /var/log/sous-firstboot.log

      echo "[Bootstrap] First-boot configuration complete. Rebooting..."
      reboot

runcmd:
  - /tmp/firstboot-bootstrap.sh

final_message: |
  Sous Tools Signage Node — cloud-init firstboot complete.
  Check /var/log/sous-firstboot.log for ansible-playbook output.
