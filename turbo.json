{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["INFISICAL_MOCK"],
  "tasks": {
    "secrets:sync": {
      "cache": false,
      "env": [
        "INFISICAL_CLIENT_ID",
        "INFISICAL_CLIENT_SECRET",
        "INFISICAL_PROJECT_ID",
        "INFISICAL_ENV"
      ]
    },
    "build": {
      "dependsOn": ["secrets:sync", "^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "dependsOn": ["secrets:sync"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
