{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "INFISICAL_MOCK"
  ],
  "tasks": {
    "secrets:sync": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "secrets:sync",
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "dependsOn": [
        "secrets:sync",
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "test": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}