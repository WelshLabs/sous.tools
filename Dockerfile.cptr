FROM python:3.11-slim

# 1. Install System, Node.js, Tailscale, and Terminal Utilities
RUN apt-get update && apt-get install -y \
    curl \
    git \
    zsh \
    sudo \
    jq \
    nano \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y nodejs \
    && curl -fsSL https://tailscale.com/install.sh | sh \
    && rm -rf /var/lib/apt/lists/*

# 2. Install Global CLI Tools (Claude & Antigravity)
RUN npm install -g @anthropic-ai/claude-code && \
    curl -fsSL https://antigravity.google/cli/install.sh | bash
    
# Add CLI tools to Dockerfile.cptr
RUN npm install -g @infisical/cli vercel && \
    curl -Ls https://download.newrelic.com/install/newrelic-cli/scripts/install.sh | bash

# 3. Setup the 1001 User and Group for Permissions
RUN groupadd -g 1001 cptrgroup && \
    useradd -u 1001 -g 1001 -m -s /bin/zsh cptruser && \
    echo "cptruser ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# 4. Install Starship for a Clean Terminal Prompt
RUN curl -sS https://starship.rs/install.sh | sh -s -- -y

# 5. Switch to the new user context
USER 1001
ENV HOME=/home/cptruser
ENV PATH="$HOME/.local/bin:$PATH"

# 6. Install uv (for the Qdrant MCP Server)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh

# 7. Configure Zsh and Starship Initialization
RUN echo 'eval "$(starship init zsh)"' >> ~/.zshrc && \
    echo 'export PATH="$HOME/.local/bin:$PATH"' >> ~/.zshrc && \
    echo 'export SHELL=/bin/zsh' >> ~/.zshrc

# 8. Install Open WebUI Computer (cptr)
RUN pip install --no-cache-dir "cptr[all]"

WORKDIR /workspace
EXPOSE 8000
# Simplified ENTRYPOINT relies on environment variables from docker-compose
ENTRYPOINT ["infisical", "run", "--", "cptr", "run", "--host", "0.0.0.0"]