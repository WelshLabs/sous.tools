{
  "context": {
    "global_injects": [
      "blueprints/coding_guidelines.md",
      "blueprints/project_blueprint.md",
      "blueprints/ui_ux_blueprint.md"
    ],
    "workspace_rules_path": "blueprints/coding_guidelines.md"
  },
  "agents": {
    "autonomous_execution": true,
    "require_approval_for_tools": false,
    "allowed_tools": [
      "read_file",
      "write_file",
      "run_terminal_command",
      "git_checkout"
    ]
  },
  "vcs": {
    "enforce_branching": true,
    "branch_prefix_mapping": {
      "Module 1": "feature/signage-",
      "Module 2": "feature/recipe-",
      "Module 3": "feature/ingestion-",
      "Module 4": "feature/procurement-"
    }
  }
}
