{
  "name": "api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "start": "node ../../packages/config/dist/cli.js nest start",
    "dev": "node ../../packages/config/dist/cli.js nest start --watch --preserveWatchOutput",
    "start:debug": "node ../../packages/config/dist/cli.js nest start --debug --watch --preserveWatchOutput",
    "start:prod": "node ../../packages/config/dist/cli.js node dist/main",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@apollo/server": "^4.11.0",
    "@as-integrations/express4": "^1.1.2",
    "@google/genai": "^2.10.0",
    "@nestjs/apollo": "^12.2.2",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/cache-manager": "^3.1.3",
    "@nestjs/swagger": "^11.0.3",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/graphql": "^12.2.2",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/websockets": "^10.4.22",
    "@soustools/api-types": "workspace:*",
    "@soustools/config": "workspace:*",
    "@soustools/logger": "workspace:*",
    "@supabase/supabase-js": "^2.43.0",
    "@types/cookie-parser": "^1.4.10",
    "bullmq": "^5.79.0",
    "cache-manager": "^7.2.9",
    "cache-manager-ioredis": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.1",
    "googleapis": "^173.0.0",
    "graphql": "^16.11.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "newrelic": "^14.1.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.22",
    "@soustools/eslint-config": "workspace:*",
    "@soustools/tsconfig": "workspace:*",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "eslint": "^9",
    "jest": "^29.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3",
    "typescript-eslint": "^8",
    "webpack": "^5.108.4",
    "webpack-node-externals": "^3.0.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
