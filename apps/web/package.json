{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sh -c 'if [ -z \"$INFISICAL_CLIENT_ID\" ]; then echo \"[web:dev] Infisical creds absent (v0 preview) -> serving Storybook design workbench on :3000\"; cd ../storybook && exec pnpm exec storybook dev -p 3000 --host 0.0.0.0 --no-open; else exec node ../../packages/config/dist/cli.js next dev -p 3000 -H 0.0.0.0; fi'",
    "build": "node ../../packages/config/dist/cli.js next build",
    "start": "node ../../packages/config/dist/cli.js next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@hookform/resolvers": "^3.3.4",
    "@serwist/next": "^9.5.11",
    "@soustools/api-client": "workspace:*",
    "@soustools/api-types": "workspace:*",
    "@soustools/design-system": "workspace:*",
    "@soustools/domain-inventory": "workspace:*",
    "@soustools/domain-pos": "workspace:*",
    "@soustools/domain-recipes": "workspace:*",
    "@soustools/domain-settings": "workspace:*",
    "@soustools/domain-signage": "workspace:*",
    "@soustools/logger": "workspace:*",
    "@soustools/config": "workspace:*",
    "@vercel/analytics": "^1.2.2",
    "@vercel/speed-insights": "^1.3.1",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.17.0",
    "next": "^15.5.18",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.51.0",
    "recharts": "^3.9.2",
    "serwist": "^9.5.11",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@soustools/eslint-config": "workspace:*",
    "@soustools/tsconfig": "workspace:*",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^20.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8"
  },
  "engines": {
    "node": ">=22.22.0"
  }
