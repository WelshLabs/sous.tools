{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["src/main.ts"]
    },
    "apps/cli": {
      "entry": ["src/main.ts"]
    },
    "apps/pos-simulator": {
      "entry": ["next.config.mjs", "src/app/page.tsx"]
    },
    "apps/setup-portal": {
      "entry": ["next.config.mjs", "src/app/page.tsx"]
    },
    "apps/web": {
      "entry": ["next.config.mjs", "src/app/page.tsx", "playwright.config.ts", "e2e/**/*.spec.ts"]
    },
    "packages/api-types": { "entry": "src/index.ts" },
    "packages/config": { "entry": "src/index.ts" },
    "packages/design-system": { "entry": "src/index.ts" },
    "packages/domain-inventory": { "entry": "src/index.ts" },
    "packages/domain-recipes": { "entry": "src/index.ts" },
    "packages/domain-settings": { "entry": "src/index.ts" },
    "packages/domain-signage": { "entry": "src/index.ts" },
    "packages/logger": { "entry": "src/index.ts" },
    "packages/supabase": { "entry": "src/index.ts" },
    "packages/eslint-config": {
      "entry": "*.js"
    },
    "packages/tsconfig": {
      "project": ["*.json"]
    }
  },
  "ignore": [
    "**/*.d.ts",
    "packages/supabase/src/database.types.ts",
    "apps/wearos/**",
    "deploy/**",
    "dist/**",
    ".next/**"
  ],
  "ignoreDependencies": [
    "husky",
    "supabase",
    "dotenv-cli",
    "turbo",
    "prettier",
    "typescript",
    "@playwright/test"
  ]
}
