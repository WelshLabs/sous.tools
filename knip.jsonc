{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "apps/api": {
      "entry": ["src/main.ts"]
    },
    "apps/cli": {
      "entry": ["src/main.ts"]
    },
    "apps/pos-simulator": {
      "entry": ["next.config.mjs", "src/app/**/*.tsx"]
    },
    "apps/setup-portal": {
      "entry": ["next.config.mjs", "src/app/**/*.tsx"]
    },
    "apps/web": {
      "entry": [
        "next.config.mjs",
        "playwright.config.ts",
        "src/app/**/{page,layout,template,error,global-error}.tsx",
        "src/app/api/**/route.ts",
        "src/instrumentation.ts",
        "src/sw.ts",
        "src/proxy.ts"
      ]
    },
    "packages/*": {
      "entry": "src/index.ts",
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignore": [
    "**/*.d.ts",
    "packages/tsconfig/**",
    "packages/eslint-config/**",
    "supabase/migrations/**"
  ],
  "ignoreDependencies": [
    "turbo",
    "pnpm",
    "eslint",
    "prettier",
    "eslint-*",
    "@typescript-eslint/*",
    "eslint-config-*",
    "ts-node",
    "@types/node"
  ]
}
