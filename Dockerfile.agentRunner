# /home/ubuntu/agent-runner/Dockerfile
FROM node:22-bullseye-slim

# 1. Install Python, GCC, Make (for node-gyp native dependencies) and Git
RUN apt-get update && apt-get install -y \
    python3 \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# 2. Install global tools: pnpm, Claude Code CLI, and GitHub MCP server
RUN npm install -g pnpm @anthropic-ai/claude-code @modelcontextprotocol/server-github

# 3. Setup non-root user to match your code-server PUID/PGID (prevents file permission locks)
ARG PUID=1000
ARG PGID=1000
RUN groupadd -g ${PGID} agentgroup || true && \
    useradd -u ${PUID} -g ${PGID} -m -s /bin/bash agentuser || true

USER ${PUID}:${PGID}
WORKDIR /workspace

# 4. Keep container alive indefinitely so n8n can exec into it
ENTRYPOINT ["tail", "-f", "/dev/null"]