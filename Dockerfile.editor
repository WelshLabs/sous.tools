FROM lscr.io/linuxserver/code-server:latest

USER root

# 1. Install critical system tools and native Node.js/npm directly from Ubuntu repos
RUN apt-get update && apt-get install -y zsh curl git psmisc tmux python3 python3-pip nodejs npm && \
    rm -rf /var/lib/apt/lists/*

# 2. Force root user layer context workspace rules
USER root
WORKDIR /workspace

# 3. Install valid packages globally as root to bypass folder permission errors
RUN npm install -g pnpm pm2 @anthropic-ai/claude-code

# 4. Switch to user layer for python setups
USER abc

# 5. Install Python dependencies safely within user scope
RUN pip3 install --user aider-chat
ENV PATH=/config/.local/bin:$PATH

# 6. Apply default shell choices natively
USER root
RUN usermod -s /bin/zsh abc

USER abc
