FROM lscr.io/linuxserver/code-server:latest

USER root

# 1. Install critical system tools, build essentials, GitHub CLI (gh), jq, and ripgrep
RUN apt-get update && apt-get install -y \
    zsh \
    curl \
    git \
    psmisc \
    tmux \
    python3 \
    python3-pip \
    nodejs \
    npm \
    jq \
    ripgrep \
    build-essential \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null \
    && apt-get update && apt-get install -y gh \
    && curl -sS https://starship.rs/install.sh | sh -s -- -y \
    && rm -rf /var/lib/apt/lists/*

# 2. Force root user layer context workspace rules
WORKDIR /workspace

# 3. Install global node packages for agent execution & process management
RUN npm install -g pnpm pm2 @anthropic-ai/claude-code @modelcontextprotocol/server-github @infisical/cli

# 4. Install python AI applications globally as root
RUN pip3 install aider-chat --break-system-packages

# 5. Restore default execution user & configure permissions for /config and /workspace
RUN mkdir -p /config && chown -R abc:abc /config /workspace && usermod -s /bin/zsh abc

USER abc

# 6. Initialize terminal environment (.zshrc, starship, aliases)
RUN echo 'eval "$(starship init zsh)"' >> /config/.zshrc \
    && echo 'if [ -f /workspace/.config/terminal/.zsh_aliases ]; then source /workspace/.config/terminal/.zsh_aliases; fi' >> /config/.zshrc
