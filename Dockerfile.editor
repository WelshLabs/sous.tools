FROM lscr.io/linuxserver/code-server:latest

USER root

# 1. Install critical system tools
RUN apt-get update && apt-get install -y zsh curl git psmisc tmux python3 python3-pip && \
    rm -rf /var/lib/apt/lists/*

# 2. Correctly register modern NodeSource binary distribution keys for Node 22
RUN apt-get update && apt-get install -y ca-certificates gnupg && \
    mkdir -p /etc/apt/keyrings && \
    curl -fsSL https://nodesource.com | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg && \
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://nodesource.com nodistro main" | tee /etc/apt/sources.list.di/nodesource.list && \
    apt-get update && apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# 3. Force root user layer context workspace rules
USER root
WORKDIR /workspace

# 4. Install packages globally as root to bypass folder permission errors
RUN npm install -g pnpm pm2 @anthropic-ai/claude-code chunkhound-mcp-server

# 5. Switch to user layer for python setups
USER abc

# 6. Install Python dependencies safely within user scope
RUN pip3 install --user aider-chat
ENV PATH=/config/.local/bin:$PATH

# 7. Apply default shell choices natively
USER root
RUN usermod -s /bin/zsh abc

USER abc
