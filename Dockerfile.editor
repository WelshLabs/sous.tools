FROM lscr.io/linuxserver/code-server:latest

USER root

# 1. Install critical system tools
RUN apt-get update && apt-get install -y zsh curl git psmisc tmux python3 python3-pip && \
    curl -sS https://starship.rs | sh -s -- -y && \
    rm -rf /var/lib/apt/lists/*

# 2. Correctly register source structures and compile Node 22
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - && \
    apt-get update && apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# 3. Install packages globally as root to bypass folder permission errors
RUN npm install -g pnpm pm2 @anthropic-ai/claude-code chunkhound-mcp-server

# 4. Switch to user layer for python setups
USER abc
WORKDIR /workspace

# 5. Install Python dependencies safely within user scope
RUN pip3 install --user aider-chat
ENV PATH=/config/.local/bin:$PATH

# 6. Apply default shell choices natively
USER root
RUN usermod -s /bin/zsh abc

USER abc