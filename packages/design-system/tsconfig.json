{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@soustools/tsconfig/react-library.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "#components/*": ["./src/components/*"],
      "#utils/*": ["./src/utils/*"],
      "#lib/*": ["./src/lib/*"],
      "#hooks/*": ["./src/hooks/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/*.stories.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.ts"
  ]
}
