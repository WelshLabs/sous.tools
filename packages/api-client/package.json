{
  "name": "@soustools/api-client",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "scripts": {
    "generate": "pnpm run generate:rest && pnpm run generate:gql",
    "generate:rest": "openapi-typescript ../../apps/api/openapi.json -o ./src/schema.d.ts",
    "generate:gql": "graphql-codegen --config codegen.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "dependencies": {
    "@soustools/config": "workspace:*",
    "@urql/core": "^6.0.3",
    "@urql/exchange-auth": "^3.0.0",
    "@urql/exchange-graphcache": "^9.0.1",
    "graphql": "^16.14.2",
    "graphql-tag": "^2.12.7",
    "graphql-ws": "^6.2.1",
    "openapi-fetch": "^0.11.1",
    "socket.io-client": "^4.8.3",
    "urql": "^5.0.3",
    "wonka": "^6.3.6"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/client-preset": "^6.1.3",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.6",
    "@graphql-codegen/typescript-urql": "^5.0.1",
    "@graphql-typed-document-node/core": "^3.2.0",
    "@soustools/tsconfig": "workspace:*",
    "@types/react": "^19.0.0",
    "openapi-typescript": "^7.3.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
