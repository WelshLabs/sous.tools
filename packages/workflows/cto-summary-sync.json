{
  "id": "cto-summary-sync",
  "name": "CTO Summary Context Synchronizer",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cto-summary",
        "options": {}
      },
      "name": "GitHub Actions Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "Hourly Schedule Sync Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 480]
    },
    {
      "parameters": {
        "command": "mkdir -p /workspace/docs/adrs /workspace/docs/context /workspace/docs/audits && echo '# Architectural & Memory Context Summary\\nGenerated: '$(date -u) > /workspace/docs/context/cto_summary.md && for f in $(find /workspace/docs/audits /workspace/docs/context /workspace/docs/adrs -type f ! -name 'README.md' ! -name 'cto_summary.md' ! -name 'repomix-output.xml'); do echo -e \"\\n\\n## File: $f\\n\" >> /workspace/docs/context/cto_summary.md && head -n 50 \"$f\" >> /workspace/docs/context/cto_summary.md; done && cat /workspace/docs/context/cto_summary.md"
      },
      "name": "Scan Docs, Audits & ADRs",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 390]
    },
    {
      "parameters": {
        "jsCode": "const summaryText = $input.first().json.stdout || '';\n\nreturn [\n  {\n    json: {\n      name: 'sous.tools Architectural Memory & ADRs',\n      description: 'Unified repository state, audit reports, and architectural decisions',\n      data: {\n        name: 'cto_summary.md',\n        content: summaryText,\n        timestamp: new Date().toISOString()\n      }\n    }\n  }\n];"
      },
      "name": "Parse Knowledge Base Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 390]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://open-webui:8080/api/v1/knowledge/create",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer sk-1234"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "name": "Sync to Open WebUI Knowledge Base",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 300]
    },
    {
      "parameters": {
        "method": "PUT",
        "url": "http://qdrant:6333/collections/architectural_memory",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"vectors\": {\"size\": 1536, \"distance\": \"Cosine\"}}",
        "options": {}
      },
      "name": "Sync to Qdrant Vector DB",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 480]
    }
  ],
  "connections": {
    "GitHub Actions Webhook": {
      "main": [
        [
          {
            "node": "Scan Docs, Audits & ADRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hourly Schedule Sync Trigger": {
      "main": [
        [
          {
            "node": "Scan Docs, Audits & ADRs",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Scan Docs, Audits & ADRs": {
      "main": [
        [
          {
            "node": "Parse Knowledge Base Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Knowledge Base Payload": {
      "main": [
        [
          {
            "node": "Sync to Open WebUI Knowledge Base",
            "type": "main",
            "index": 0
          },
          {
            "node": "Sync to Qdrant Vector DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
