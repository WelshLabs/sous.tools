{
  "name": "CTO Summary & Open WebUI Knowledge Sync",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "cto-summary",
        "options": {}
      },
      "name": "GitHub Actions Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "name": "Hourly Schedule Sync Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 480]
    },
    {
      "parameters": {
        "command": "cat /workspace/docs/context/cto_summary.md 2>/dev/null || cat /etc/n8n/workflows/cto_summary.md 2>/dev/null || echo '# CTO Summary\\nNo report found.'"
      },
      "name": "Read CTO Summary File",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [480, 390]
    },
    {
      "parameters": {
        "jsCode": "const summaryText = $input.first().json.stdout || '';\nconst lines = summaryText.split('\\n');\nconst title = lines.find(l => l.startsWith('# ')) || '# CTO Summary Report';\n\nreturn [\n  {\n    json: {\n      name: 'CTO Summary Knowledge Base',\n      description: 'Unified technical architecture, audits, and CTO summaries',\n      data: {\n        name: 'CTO Summary',\n        content: summaryText,\n        timestamp: new Date().toISOString()\n      }\n    }\n  }\n];"
      },
      "name": "Parse Knowledge Base Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [700, 390]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://open-webui:8080/api/v1/knowledge/create",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer sk-1234"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {}
      },
      "name": "Sync to Open WebUI Knowledge Base",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [920, 390]
    }
  ],
  "connections": {
    "GitHub Actions Webhook": {
      "main": [
        [
          {
            "node": "Read CTO Summary File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Hourly Schedule Sync Trigger": {
      "main": [
        [
          {
            "node": "Read CTO Summary File",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read CTO Summary File": {
      "main": [
        [
          {
            "node": "Parse Knowledge Base Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Parse Knowledge Base Payload": {
      "main": [
        [
          {
            "node": "Sync to Open WebUI Knowledge Base",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
