{
  "name": "@soustools/logger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "default": "./dist/browser.js"
    },
    "./langfuse": {
      "types": "./dist/langfuse.d.ts",
      "default": "./dist/langfuse.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@soustools/config": "workspace:*",
    "langfuse": "^3.35.2",
    "pino": "^9.0.0"
  },
  "devDependencies": {
    "@soustools/eslint-config": "workspace:*",
    "@soustools/tsconfig": "workspace:*",
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "pino-pretty": "^11.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8"
  }
}
