{
  "name": "sous",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo test",
    "knip": "knip",
    "db:start": "docker compose -f supabase/docker/docker-compose.yml up -d",
    "db:stop": "docker compose -f supabase/docker/docker-compose.yml down",
    "db:restart": "pnpm db:stop && pnpm db:start",
    "db:generate": "pnpm -F supabase supabase:generate",
    "db:push": "pnpm -F supabase supabase:push",
    "db:reset": "pnpm -F supabase supabase:reset",
    "db:seed": "pnpm -F supabase supabase:seed",
    "db:studio": "pnpm -F supabase supabase:studio",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.2.0",
    "@playwright/test": "^1.44.0",
    "@soustools/eslint-config": "workspace:*",
    "@soustools/tsconfig": "workspace:*",
    "eslint": "^9.2.0",
    "eslint-plugin-react-hooks": "rc",
    "globals": "^15.2.0",
    "husky": "^9.0.11",
    "knip": "^5.12.0",
    "lint-staged": "^15.2.2",
    "prettier": "^3.2.5",
    "turbo": "latest",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.1.0",
  "dependencies": {
    "eslint-plugin-react": "^7.34.1"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.0.0",
      "@types/react-dom": "^19.0.0"
    }
  }
}
