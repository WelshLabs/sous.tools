{
  "name": "sous",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "dotenv -- turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "turbo test",
    "knip": "knip",
    "db:start": "docker compose -f supabase/docker/docker-compose.yml up -d",
    "db:stop": "docker compose -f supabase/docker/docker-compose.yml down",
    "db:restart": "pnpm db:stop && pnpm db:start",
    "db:gen-types": "supabase gen types typescript --project-id \"$PROJECT_REF\" --schema public > packages/supabase/src/database.types.ts",
    "db:pull": "supabase db pull",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:seed": "node scripts/seed-db.mjs",
    "prepare": "husky install",
    "check-types": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@playwright/test": "^1.44.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "dotenv-cli": "^7.4.2",
    "husky": "^9.0.11",
    "knip": "^5.25.0",
    "prettier": "^3.2.5",
    "supabase": "^1.172.2",
    "turbo": "latest",
    "typescript": "^5.4.5"
  },
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=18"
  }
}
