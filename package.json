{
  "name": "sous.tools",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "db:reset": "node packages/config/dist/cli.js pnpm run db:reset:env",
    "db:reset:env": "npx ts-node scripts/nuke-neo4j.ts && npx ts-node scripts/prepare-seed.ts && PGSSLMODE=disable npx supabase db reset --db-url=\"$SUPABASE_DIRECT_URL\"",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "NODE_OPTIONS='--max-old-space-size=2048' turbo typecheck --concurrency=1",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "INFISICAL_MOCK=true turbo test",
    "knip": "knip",
    "prepare": "husky",
    "secrets:sync": "pnpm --filter @soustools/config secrets:sync",
    "audit:secrets": "npx tsx scripts/audit-secrets.ts",
    "clean:all": "rm -rf node_modules apps/*/node_modules packages/*/node_modules apps/*/.next apps/*/dist packages/*/dist .turbo apps/*/.turbo packages/*/.turbo && pnpm install",
    "clean:dockerimages": "sudo bash -c 'rm -rf node_modules apps/*/node_modules packages/*/node_modules .pnpm-store'",
    "push:all": "git push origin HEAD:main HEAD:staging",
    "build:packages": "pnpm --filter './packages/**' build",
    "prompt:setup": "cat .agents/setup-prompt.txt | xclip -selection clipboard && echo '✅ Setup prompt copied to clipboard!'",
    "prompt:teardown": "cat .agents/teardown-prompt.txt | xclip -selection clipboard && echo '✅ Teardown prompt copied!'"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@soustools/api-types": "workspace:*",
    "@soustools/config": "workspace:*",
    "@soustools/eslint-config": "workspace:*",
    "@soustools/tsconfig": "workspace:*",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.46",
    "@types/node": "^26.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "eslint-plugin-project-structure": "^3.14.3",
    "eslint-plugin-react-hooks": "rc",
    "eslint-plugin-tailwindcss": "^4.2.0",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "knip": "^5.88.1",
    "lint-staged": "^15.5.2",
    "png-to-ico": "^3.0.2",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "repomix": "^1.16.1",
    "sharp": "^0.35.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.12",
    "turbo": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^7.18.0"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "packageManager": "pnpm@11.21.0",
  "dependencies": {
    "dotenv": "^16.6.1",
    "eslint-plugin-react": "^7.37.5",
    "neo4j-driver": "^6.2.0",
    "pg": "^8.23.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  }
}
