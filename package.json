{
  "name": "sous-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "dotenv -- turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:types": "pnpm --filter @sous-chefs/supabase db:types",
    "knip": "knip"
  },
  "devDependencies": {
    "@sous-chefs/eslint-config": "workspace:*",
    "@sous-chefs/tsconfig": "workspace:*",
    "dotenv-cli": "^7.4.2",
    "knip": "^5.25.0",
    "prettier": "^3.3.2",
    "turbo": "^2.0.4"
  },
  "packageManager": "pnpm@9.1.1",
  "engines": {
    "node": ">=18"
  }
}
