          {(block.blocks || []).map((sub: SignageBlock, idx: number) => (
            <PreviewBlockRenderer key={idx} block={sub} items={items} styles={styles} onFetchModifierOptions={onFetchModifierOptions} />
          ))}
        </div>
      );
