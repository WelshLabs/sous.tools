  redis_data:
  ollama_data:
  n8n_data:
  agent_data:
  neo4j_data:
  open-webui_data:

networks:
  default:
  traefik_public:
    name: traefik_public
    external: true
  supabase_network:
    name: supabase_network_sous.tools
    external: true
