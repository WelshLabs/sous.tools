    home: "{{ signage_home }}"
    create_home: true
    state: present

- name: Enable systemd lingering for soustools
  ansible.builtin.command:
    cmd: "loginctl enable-linger {{ signage_user }}"
  changed_when: false

- name: Create signage application directories
  ansible.builtin.file:
    path: "{{ item }}"
    state: directory
    owner: "{{ signage_user }}"
    group: "{{ signage_user }}"
    mode: "0755"
  loop:
