    lineItems.forEach((line, idx: number) => {
      const externalItemId = line.catalog_object_id || "";
      const posItemId = externalItemId ? (itemMap.get(externalItemId) || null) : null;

      const grossRevenue = (line.gross_sales_money?.amount || 0) / 100;
