  } : undefined;

  const recipeIngredients: RecipeIngredient[] = ingredientsRaw ? ingredientsRaw.map((ri) => {
    const mi = ri.items as Record<string, unknown> | null;
    const macros = (mi?.nutrition_macros || {}) as Record<string, unknown>;
