          x="25"
          y="78"
          width="50"
          height="10"
          rx="3"
          fill={paint}
          initial={{ scaleX: 0, opacity: 0 }}
          animate={{ scaleX: [0, 1, 1], opacity: [0, 1, 0.4] }}
          style={{ transformOrigin: "25px 83px" }}
          transition={strokeTransition}
