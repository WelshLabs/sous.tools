    .select("id, external_id")
    .eq("organization_id", orgId)
    .eq("pos_provider", "SQUARE");

  const mgMap = new Map(
    (dbModifierGroups || []).map((g) => [g.external_id, g.id]),
  );

  const modifierOptionsToUpsert = mapSquareModifierOptions(
    modifierLists,
    mgMap,
    orgId,
  );
  if (modifierOptionsToUpsert.length > 0) {
    await bulkUpsert(
