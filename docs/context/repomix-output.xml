      item={item}
      formData={formData}
      loading={loading}
      usdaQuery={usdaQuery}
      usdaLoading={usdaLoading}
      hasSearchHandler={!!onSearchUSDA}
      onClose={onClose}
      onQueryChange={setUsdaQuery}
      onSearch={searchUSDA}
      handleSubmit={handleSubmit}
      handleChange={handleChange}
