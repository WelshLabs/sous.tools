export const FontPickerPopover: React.FC<FontPickerPopoverProps> = ({
  currentFont,
  onSelect,
  onClose,
  label,
}) => {
  const ref = useRef<HTMLDivElement>(null);
  const [customFont, setCustomFont] = useState("");

