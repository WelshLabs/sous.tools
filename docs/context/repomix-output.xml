  onSelectSuggestion,
  onAddFreeText,
  placeholder = "I noticed we are low on...",
}: QuickAddBarProps) {
  const inputRef = React.useRef<HTMLInputElement>(null);

  const handleKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
    if (e.key === "Enter" && value.trim()) {
      e.preventDefault();
